{
  "name": "cozinhadosbonitos-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Sanity studio for Cozinha dos Bonitos",
  "main": "package.json",
  "author": "Bruno Alla <alla.brunoo@gmail.com>",
  "license": "MIT",
  "scripts": {
    "format": "oxfmt",
    "check:lint": "oxlint",
    "check:format": "oxfmt --check",
    "check:types": "tsc",
    "deploy": "npm run deploy:studio && npm run deploy:graphql",
    "deploy:studio": "sanity deploy",
    "deploy:graphql": "sanity graphql deploy --force",
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "6.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "sanity": "6.16.0",
    "styled-components": "6.5.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "5.4.2",
      "smol-toml": "1.9.0"
    },
    "@module-federation/dts-plugin": {
      "undici": "8.11.2"
    }
  },
  "renovate": {
    "extends": [
      "github>browniebroke/renovate-configs:js-app"
    ]
  },
  "devDependencies": {
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0"
  }
}
